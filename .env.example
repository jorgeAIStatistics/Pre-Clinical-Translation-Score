# ─────────────────────────────────────────────────────────────────────────────
# Preclinical Translational Risk Scorer — environment template
# Copy to .env and fill in. NEVER commit .env.
# ─────────────────────────────────────────────────────────────────────────────

# ---- Core ----
TRS_ENV=development                       # development | staging | production
TRS_LOG_LEVEL=INFO

# ---- Database ----
# Production target is PostgreSQL 15+. Local development defaults to SQLite so
# the stack runs with zero external services. The SQLAlchemy models and Alembic
# migrations are portable across both.
#   Postgres: postgresql+psycopg://trs:trs@localhost:5432/trs
#   SQLite:   sqlite+pysqlite:///./trs.db
TRS_DATABASE_URL=sqlite+pysqlite:///./trs.db

# ---- Security ----
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
TRS_SECRET_KEY=CHANGE_ME_generate_a_random_48_byte_urlsafe_token
TRS_ACCESS_TOKEN_TTL_MINUTES=720
TRS_CORS_ORIGINS=http://localhost:3000

# ---- Rate limiting ----
TRS_RATE_LIMIT_PER_MINUTE=120
TRS_RATE_LIMIT_BURST=40

# ---- Model artifacts ----
TRS_ARTIFACT_DIR=./artifacts
TRS_ACTIVE_MODEL_VERSION=                 # blank = use the registry's active pointer

# ---- Ingestion connectors ----
# NCBI asks that you identify yourself; an API key raises the rate limit to 10 rps.
TRS_NCBI_EMAIL=
TRS_NCBI_API_KEY=
TRS_NCBI_TOOL=preclinical-translational-risk-scorer

# OpenAlex / Crossref use a "polite pool" keyed on a contact email.
TRS_OPENALEX_MAILTO=
TRS_CROSSREF_MAILTO=

# Open Targets Platform GraphQL (public, no key required)
TRS_OPENTARGETS_URL=https://api.platform.opentargets.org/api/v4/graphql

# ChEMBL REST (public, no key required)
TRS_CHEMBL_URL=https://www.ebi.ac.uk/chembl/api/data

# ClinicalTrials.gov API v2 (public, no key required)
TRS_CTGOV_URL=https://clinicaltrials.gov/api/v2

# HTTP cache for connector responses (raw payloads are retained verbatim)
TRS_CONNECTOR_CACHE_DIR=./.cache
TRS_CONNECTOR_CACHE_TTL_HOURS=168
TRS_CONNECTOR_TIMEOUT_SECONDS=30
TRS_CONNECTOR_MAX_RETRIES=3

# ---- Frontend (frontend/.env.local) ----
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
