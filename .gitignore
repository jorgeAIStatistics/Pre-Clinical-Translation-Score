# Python
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
.mypy_cache/

# Node
node_modules/
.next/
out/
*.tsbuildinfo
.turbo/

# Local data & secrets — never commit these
.env
.env.local
*.db
*.sqlite3
*.db-wal
*.db-shm

# Connector cache: reproducible from the sources, and large
backend/.cache/
!backend/.cache/.gitkeep

# Model artifacts and simulation ground truth: build products, regenerated by
# `make demo`. Keeping them out of git avoids a 5 MB JSON blob per training run
# and keeps the ground-truth file from ever being mistaken for real data.
backend/artifacts/*
!backend/artifacts/.gitkeep

# OS
.DS_Store
